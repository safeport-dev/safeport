{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "safeport-web",
  "compatibility_date": "2026-11-01",
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    // Separate Worker for PR previews. See docs/adr/0001-cloudflare-platform.md.
    "preview": {
      "preview_urls": true
    }
  }
}
